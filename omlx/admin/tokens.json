{
  "_comment": "Single source of truth for the oMLX admin console's design tokens. The web console and the macOS app both read the generated artifacts, never this file directly. Regenerate with `python omlx/admin/build_tokens.py`; CI drift is caught by tests/test_design_tokens.py.",
  "version": 1,
  "surface": {
    "light": {
      "bgPrimary": "#ffffff",
      "bgSecondary": "#f8fafc",
      "bgTertiary": "#f1f5f9",
      "borderFaint": "#e2e8f0",
      "borderNormal": "#cbd5e1"
    },
    "dark": {
      "bgPrimary": "#1d1d20",
      "bgSecondary": "#252529",
      "bgTertiary": "#2d2d32",
      "borderFaint": "#3f3f46",
      "borderNormal": "#52525b"
    }
  },
  "text": {
    "light": {
      "primary": "#0f172a",
      "secondary": "#475569",
      "tertiary": "#64748b",
      "muted": "#94a3b8",
      "danger": "#ef4444",
      "link": "#2563eb"
    },
    "dark": {
      "primary": "#efefef",
      "secondary": "#a1a1aa",
      "tertiary": "#71717a",
      "muted": "#52525b",
      "danger": "#f87171",
      "link": "#60a5fa"
    }
  },
  "control": {
    "light": {
      "primary": "#171717",
      "primaryHover": "#27272a",
      "primaryText": "#ffffff",
      "dangerHover": "rgba(239, 68, 68, 0.1)",
      "focusRing": "#171717",
      "codeBg": "#f3f4f6",
      "dangerText": "#ffffff"
    },
    "dark": {
      "primary": "#e5e5e5",
      "primaryHover": "#d4d4d4",
      "primaryText": "#18181b",
      "dangerHover": "rgba(239, 68, 68, 0.2)",
      "focusRing": "#efefef",
      "codeBg": "#27272a",
      "dangerText": "#ffffff"
    }
  },
  "semantic": {
    "_comment": "Apple system colors, expressed per appearance so the web console reads the same weight as the native app's status dots.",
    "light": {
      "red": "#ff3b30",
      "orange": "#ff9500",
      "green": "#34c759",
      "blue": "#007aff",
      "accent": "#3b82f6"
    },
    "dark": {
      "red": "#ff453a",
      "orange": "#ff9f0a",
      "green": "#30d158",
      "blue": "#0a84ff",
      "accent": "#60a5fa"
    }
  },
  "typography": {
    "_comment": "Six levels, no others. The floor rules are enforced by the generated CSS and by the app's DesignTokens.",
    "families": {
      "sans": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Noto Sans CJK SC', 'Microsoft YaHei', sans-serif",
      "mono": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace"
    },
    "scale": {
      "aux": {
        "px": 10,
        "lineHeight": 1.4,
        "usage": "captions, timestamps, table secondary cells, badges"
      },
      "body": {
        "px": 12,
        "lineHeight": 1.5,
        "usage": "body copy, form labels, table primary cells"
      },
      "emphasis": {
        "px": 15,
        "lineHeight": 1.45,
        "usage": "group and card titles"
      },
      "section": {
        "px": 17,
        "lineHeight": 1.4,
        "usage": "section headings, drawer and sheet titles"
      },
      "page": {
        "px": 20,
        "lineHeight": 1.3,
        "usage": "page title"
      },
      "kpi": {
        "px": 28,
        "lineHeight": 1.15,
        "usage": "metric figures"
      }
    },
    "floor": {
      "aux": 10,
      "body": 12,
      "enhancedReadability": 12
    },
    "tailwindAliases": {
      "xs": "body",
      "sm": "body",
      "base": "emphasis",
      "lg": "emphasis",
      "xl": "section",
      "2xl": "page",
      "3xl": "kpi",
      "4xl": "kpi"
    }
  },
  "space": {
    "_comment": "8pt grid. 4pt exists only for icon-to-label gaps.",
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24,
    "6": 32,
    "8": 48,
    "10": 64
  },
  "radius": {
    "sm": 6,
    "md": 8,
    "lg": 12,
    "pill": 999
  },
  "layout": {
    "gutter": 32,
    "formMaxWidth": 760,
    "wideMaxWidth": 1200,
    "scrollbarGutter": "stable",
    "kpiMinWidth": 220,
    "heatLabelColumn": 90
  },
  "material": {
    "_comment": "One translucent layer only: the top bar. Content surfaces stay solid.",
    "topBarBlur": 20,
    "topBarSaturate": 1.8,
    "light": {
      "topBarBg": "rgba(255, 255, 255, 0.72)",
      "topBarBorder": "rgba(15, 23, 42, 0.08)"
    },
    "dark": {
      "topBarBg": "rgba(29, 29, 32, 0.72)",
      "topBarBorder": "rgba(255, 255, 255, 0.08)"
    }
  },
  "elevation": {
    "_comment": "Micro shadows replace hard borders on cards and popovers.",
    "card": "0 1px 2px rgba(15, 23, 42, 0.04), 0 1px 3px rgba(15, 23, 42, 0.06)",
    "popover": "0 8px 24px rgba(15, 23, 42, 0.12)",
    "glow": "0 0 0 3px rgba(10, 132, 255, 0.18)"
  }
}
